#!/bin/bash
# {{ ansible_managed }}
# Looks for processes hidden by rootkits and mails the report.
set -u

DATE=$(date +%Y-%m-%d)
HOST=$(hostname)
LOG_DIR="{{ unhide_log_directory }}"

cd "$LOG_DIR" || exit 1
# -f writes the log to unhide-linux_<date>_<time>.log in the current directory
/usr/sbin/unhide-linux -m -f -d sys procall brute reverse
REPORT=$(ls -1t "$LOG_DIR"/unhide-linux_*.log | head -n 1)

find "$LOG_DIR" -type f -mtime +{{ antirootkits_log_expire }} -delete

mail -s "${HOST}: Unhide audit (${DATE})" -r "{{ antirootkits_mail_from }}" \
  "{{ antirootkits_mail_to }}" < "$REPORT"
